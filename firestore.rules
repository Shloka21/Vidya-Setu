rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper: Is the request from an authenticated user? ───
    function isAuth() {
      return request.auth != null;
    }

    // ─── Helper: Is the requesting user the document owner? ───
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // ─── Users ────────────────────────────────────────────────
    match /users/{userId} {
      // Any authenticated user can read any user profile
      // (needed for mentor search, chat participant info, etc.)
      allow read: if isAuth();

      // Users can only create/update their own document
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);

      // Users cannot delete their own document (admin only)
      allow delete: if false;

      // ─── Sub-collections under a user ───────────────────────

      // Reminders: owner can CRUD, connected mentors can read
      match /reminders/{reminderId} {
        allow read, write: if isOwner(userId);
        // Mentors can read reminders if they are listed as mentorId
        allow read: if isAuth() && resource.data.mentorId == request.auth.uid;
      }

      // Timetables: only the owner
      match /timetables/{timetableId} {
        allow read, write: if isOwner(userId);
      }

      // Study Plans: only the owner
      match /studyPlans/{planId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ─── Chat Rooms ───────────────────────────────────────────
    match /chatRooms/{roomId} {
      // Participants can read and update chat rooms
      allow read, update: if isAuth()
        && request.auth.uid in resource.data.participants;

      // Any authenticated user can create a chat room
      allow create: if isAuth();

      allow delete: if false;

      // Messages inside a chat room
      match /messages/{messageId} {
        // Participants of the parent chat room can read/write messages
        allow read, write: if isAuth()
          && request.auth.uid in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.participants;
      }
    }

    // ─── Connections (mentor-student) ─────────────────────────
    match /connections/{connectionId} {
      // Both the student and mentor in the connection can read
      allow read: if isAuth()
        && (request.auth.uid == resource.data.studentId
            || request.auth.uid == resource.data.mentorId);

      // Students can create connection requests
      allow create: if isAuth();

      // Both parties can update (approve/decline)
      allow update: if isAuth()
        && (request.auth.uid == resource.data.studentId
            || request.auth.uid == resource.data.mentorId);

      allow delete: if isAuth()
        && (request.auth.uid == resource.data.studentId
            || request.auth.uid == resource.data.mentorId);
    }

    // ─── Feedback ─────────────────────────────────────────────
    match /feedback/{feedbackId} {
      allow read: if isAuth()
        && (request.auth.uid == resource.data.studentId
            || request.auth.uid == resource.data.mentorId);

      // Mentors can create feedback
      allow create: if isAuth();

      allow update: if isAuth()
        && request.auth.uid == resource.data.mentorId;

      allow delete: if false;
    }

    // ─── Meetings ─────────────────────────────────────────────
    match /meetings/{meetingId} {
      allow read: if isAuth()
        && request.auth.uid in resource.data.participants;

      allow create: if isAuth();

      allow update: if isAuth()
        && request.auth.uid in resource.data.participants;

      allow delete: if isAuth()
        && request.auth.uid in resource.data.participants;
    }

    // ─── Active Calls ─────────────────────────────────────────
    match /activeCalls/{callId} {
      allow read: if isAuth()
        && (request.auth.uid == resource.data.callerId
            || request.auth.uid == resource.data.receiverId);

      allow create: if isAuth();

      allow update, delete: if isAuth()
        && (request.auth.uid == resource.data.callerId
            || request.auth.uid == resource.data.receiverId);
    }
  }
}
